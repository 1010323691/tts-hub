# Copy to .env and edit. start.ps1 loads it; real environment variables win.
# Service-wide settings are TTS_*; the old BREEZE_* names (BREEZE_PORT, ...) are still read as
# fallbacks. Engine-specific settings keep the engine prefix: BREEZE_MODEL, QWEN_*_MODEL.
TTS_HOST=127.0.0.1
TTS_PORT=7861
# Engine used when a request names none (loaded at startup): breeze | qwen3
TTS_ENGINE=breeze
# Engine weights: HuggingFace repo ids or local checkpoint directories
BREEZE_MODEL=BreezeBlue/breeze-tts-2
QWEN_CUSTOM_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
QWEN_BASE_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
QWEN_DESIGN_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
TTS_DEVICE=auto
# Required when TTS_HOST is not 127.0.0.1 (clients send Authorization: Bearer <key>)
TTS_API_KEY=
# Base URL written into returned audio_url fields (e.g. behind a reverse proxy)
TTS_PUBLIC_URL=
# Upper bound on rows per generate() call. Each batch is sized automatically from the fitted
# VRAM model against the VRAM free at that moment; lower this only to leave VRAM for other apps.
# Another GPU: stop the service and run scripts\calibrate_vram.py (writes data\vram_fit.json).
TTS_MAX_BATCH=128
TTS_MAX_CHUNK_CHARS=120
TTS_DATA_DIR=
TTS_SEED_VOICES=1
# Idle lifecycle (minutes, 0 = off): no API request for UNLOAD minutes -> weights leave the
# GPU (next request reloads, ~30 s); SHUTDOWN more minutes after that -> process exits.
# /health polling does not count as a request.
TTS_IDLE_UNLOAD_MINUTES=10
TTS_IDLE_SHUTDOWN_MINUTES=30
# Optional: reuse weights from another HuggingFace cache location
# HF_HOME=
